# Copy this file to .env for local development only.
# Never commit real passwords or API secrets.

APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost

# Local database defaults. On Railway you can also use DATABASE_URL or MYSQL_URL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=autokul_sto
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_AUTO_MIGRATE=true

# Cloudinary dashboard values.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=autokul_sto

UPLOAD_MAX_SIZE=5242880
